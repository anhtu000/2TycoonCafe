{
  "name": "tycoon-cafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:cg": "vite --mode crazygames",
    "build": "tsc --noEmit && vite build --mode crazygames && node scripts/check-build.mjs dist/crazygames crazygames",
    "build:web": "tsc --noEmit && vite build --mode web && node scripts/check-build.mjs dist/web web",
    "build:poki": "tsc --noEmit && vite build --mode poki && node scripts/check-build.mjs dist/poki poki",
    "dev:poki": "vite --mode poki",
    "preview": "vite preview --outDir dist/crazygames",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/core.test.ts src/logic/cafe.test.ts",
    "sync-core": "node scripts/sync-core.mjs",
    "sim": "node --experimental-strip-types tools/sim/run.ts 200",
    "sim:quick": "node --experimental-strip-types tools/sim/quick.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@fontsource/nunito": "5.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
